# =========================================================================
# 1. NEXT.JS & NODE.JS (FRONTEND)
# =========================================================================
node_modules/
.next/
out/
build/
dist/

# Log file local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================================================================
# 2. FASTAPI, CELERY & PYTHON (BACKEND)
# =========================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Virtual Environment (Wajib diabaikan karena ukurannya sangat besar)
.venv/
venv/
env/
ENV/

# Celery beats & process files
celerybeat-schedule
celerybeat.pid

# =========================================================================
# 3. DATABASE & CACHE LOCAL (POSTGRESQL / ALLOYDB, REDIS)
# =========================================================================
# Mengabaikan file dump database lokal atau log Redis jika ada di folder proyek
*.sql
*.dump
*.log
*.db-wal
*.db-shm
redis.conf

# =========================================================================
# 4. KEAMANAN & KREDENSIAL (SANGAT WAJIB DIABAIKAN)
# =========================================================================
# Jangan pernah mengepush file .env yang berisi password database, token, atau API keys!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# =========================================================================
# 5. IDE / TEXT EDITOR & OS TRASH
# =========================================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
